{
  "name": "gradient-ui",
  "version": "0.0.0",
  "private": false,
  "scripts": {
    "dev": "vite",
    "build:docs": "vite build --outDir dist-docs",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "build": "npm run build:lib && npm run build:docs",
    "preview:docs": "vite preview --outDir dist-docs",
    "eslint": "eslint .",
    "eslint:fix": "eslint --fix .",
    "lint:css": "stylelint src",
    "lint:css:fix": "npm run lint:css -- --fix",
    "schema": "node utils/generateApi.js",
    "type-check": "vue-tsc -b",
    "type-check:lib": "vue-tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.10",
    "@fontsource/manrope": "^5.1.1",
    "@material/material-color-utilities": "^0.4.0",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@vueuse/core": "^12.5.0",
    "gib-validate": "^1.1.0",
    "gsap": "^3.12.7",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@fontsource/roboto": "^5.1.1",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.1.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.7.7",
    "@types/vuelidate": "^0.7.22",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-service": "^5.0.8",
    "@vue/tsconfig": "^0.5.1",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "bulma": "^1.0.2",
    "click-outside-vue3": "^4.0.1",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^9.28.0",
    "floating-vue": "^5.2.2",
    "meow": "^9.0.0",
    "openapi-typescript": "^5.4.2",
    "postcss": "^8.5.1",
    "postcss-html": "^1.8.1",
    "postcss-preset-env": "^10.1.3",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.83.4",
    "stylelint": "^16.14.0",
    "stylelint-color-format": "^1.1.0",
    "stylelint-config-clean-order": "^7.0.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^6.10.1",
    "stylelint-z-index-value-constraint": "^1.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0",
    "vite": "^5.4.1",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-stylelint": "^6.0.0",
    "vue": "^3.5.20",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.0.29",
    "vue3-ripple": "^1.0.8"
  },
  "overrides": {
    "vue-demi": "0.14.10"
  },
  "type": "module",
  "description": "Gradient-aware Vue 3 component library.",
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "**/*.css",
    "**/*.scss",
    "src/style.scss"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./styles": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  }
}
