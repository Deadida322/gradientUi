{
	"name": "@gradient-ui/core",
	"version": "1.0.1",
	"private": false,
	"scripts": {
		"dev": "npm run dev -w @gradient-ui/docs",
		"dev:docs": "npm run dev -w @gradient-ui/docs",
		"build:docs": "npm run build -w @gradient-ui/docs",
		"clean:lib": "node scripts/clean-build-output.mjs dist",
		"build:gradient-engine": "npm run build -w @gradient-ui/gradient-engine",
		"build:nuxt": "npm run build -w @gradient-ui/nuxt",
		"build:figma-plugin": "npm run build:gradient-engine && npm run build -w @gradient-ui/figma-plugin",
		"build:lib": "npm run clean:lib && npm run build:gradient-engine && vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json && node scripts/prepare-dual-declarations.mjs dist --node-extensions",
		"build": "npm run build:lib && npm run build:docs",
		"preview:docs": "npm run preview -w @gradient-ui/docs",
		"prettier": "prettier --check . --ignore-unknown",
		"prettier:check": "prettier --check . --ignore-unknown",
		"prettier:write": "prettier --write . --ignore-unknown",
		"eslint": "eslint .",
		"eslint:fix": "eslint --fix .",
		"lint:css": "stylelint src docs/src",
		"lint:css:fix": "npm run lint:css -- --fix",
		"type-check": "npm run build:gradient-engine && vue-tsc -b && npm run type-check:docs",
		"type-check:gradient-engine": "npm run type-check -w @gradient-ui/gradient-engine",
		"type-check:figma-plugin": "npm run type-check -w @gradient-ui/figma-plugin",
		"type-check:nuxt": "npm run type-check -w @gradient-ui/nuxt",
		"type-check:lib": "vue-tsc -p tsconfig.lib.json",
		"type-check:docs": "npm run type-check -w @gradient-ui/docs",
		"test:ssr:core:run": "vitest run --config vitest.ssr.config.ts",
		"test:ssr:nuxt:run": "vitest run --config vitest.nuxt.config.ts",
		"test:ssr": "npm run build:lib && npm run test:ssr:core:run",
		"test:ssr:compat": "npm run build:lib && npm run build:nuxt && npm run test:ssr:nuxt:run",
		"test:ssg:run": "nuxt generate tests/fixtures/nuxt && nuxt generate tests/fixtures/nuxt-csp && vitest run --config vitest.ssg.config.ts",
		"test:ssg": "npm run build:lib && npm run build:nuxt && npm run test:ssg:run",
		"test:package:run": "publint packages/gradient-engine --pack npm && publint --pack npm && publint packages/nuxt --pack npm && attw --pack packages/gradient-engine && attw --pack . --exclude-entrypoints ./style.css ./styles ./styles/media && attw --pack packages/nuxt --profile esm-only",
		"test:package": "npm run build:lib && npm run build:nuxt && npm run test:package:run",
		"test:ssr:all": "npm run build:lib && npm run build:nuxt && npm run test:ssr:core:run && npm run test:ssr:nuxt:run && npm run test:ssg:run && npm run test:package:run",
		"version:sync": "node scripts/workspace-versions.mjs sync",
		"version:check": "node scripts/workspace-versions.mjs check",
		"test:release": "node --test tests/release/workspace-releases.test.mjs",
		"release:publish": "node scripts/publish-workspaces.mjs",
		"release:ssr:check": "npm run eslint && npm run type-check && npm run lint:css && npm run test:ssr:all",
		"release:gradient-engine:check": "npm run type-check:gradient-engine && npm run build:gradient-engine",
		"release:gradient-engine:pack": "npm run release:gradient-engine:check && npm pack -w @gradient-ui/gradient-engine",
		"release:gradient-engine:publish": "npm run release:gradient-engine:check && npm publish -w @gradient-ui/gradient-engine --access public",
		"prepack": "npm run build:lib"
	},
