{
	"name": "@gradient-ui/nuxt",
	"version": "1.0.1",
	"type": "module",
	"description": "Nuxt integration for Gradient UI.",
	"license": "MIT",
	"author": "David Aliev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Deadida322/gradientUi.git",
		"directory": "packages/nuxt"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"exports": {
		".": {
			"types": "./dist/module.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "npm run type-check && node ../../scripts/clean-build-output.mjs dist && nuxt-module-build build",
		"type-check": "nuxt-module-build prepare && tsc -p tsconfig.json --noEmit",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@nuxt/kit": "^3.21.1 || ^4.0.0"
	},
	"peerDependencies": {
		"@gradient-ui/core": "^1.0.1"
	},
	"devDependencies": {
		"@nuxt/module-builder": "^1.0.3",
		"@nuxt/schema": "4.5.2",
		"typescript": "^5.5.4"
	}
}
