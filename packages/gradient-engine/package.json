{
	"name": "@gradient-ui/gradient-engine",
	"version": "2.0.0",
	"private": false,
	"type": "module",
	"description": "Framework-free gradient generation engine for CSS, SVG, canvas, effects and material tokens.",
	"license": "MIT",
	"author": "David Aliev",
	"keywords": [
		"gradient",
		"gradients",
		"css-gradient",
		"svg-gradient",
		"canvas-gradient",
		"color",
		"color-palette",
		"material-you",
		"design-system",
		"animation",
		"effects",
		"typescript",
		"framework-agnostic"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Deadida322/gradientUi.git",
		"directory": "packages/gradient-engine"
	},
	"bugs": {
		"url": "https://github.com/Deadida322/gradientUi/issues"
	},
	"homepage": "https://gradient-ui-docs.netlify.app/docs/gradient-engine",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/types/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/types/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/types-cjs/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./core": {
			"import": {
				"types": "./dist/types/core.d.ts",
				"default": "./dist/core.mjs"
			},
			"require": {
				"types": "./dist/types-cjs/core.d.cts",
				"default": "./dist/core.cjs"
			}
		},
		"./formatters": {
			"import": {
				"types": "./dist/types/formatters/index.d.ts",
				"default": "./dist/formatters.mjs"
			},
			"require": {
				"types": "./dist/types-cjs/formatters/index.d.cts",
				"default": "./dist/formatters.cjs"
			}
		},
		"./effects": {
			"import": {
				"types": "./dist/types/effects/index.d.ts",
				"default": "./dist/effects.mjs"
			},
			"require": {
				"types": "./dist/types-cjs/effects/index.d.cts",
				"default": "./dist/effects.cjs"
			}
		},
		"./animation": {
			"import": {
				"types": "./dist/types/animation/index.d.ts",
				"default": "./dist/animation.mjs"
			},
			"require": {
				"types": "./dist/types-cjs/animation/index.d.cts",
				"default": "./dist/animation.cjs"
			}
		},
		"./material": {
			"import": {
				"types": "./dist/types/material.d.ts",
				"default": "./dist/material.mjs"
			},
			"require": {
				"types": "./dist/types-cjs/material.d.cts",
				"default": "./dist/material.cjs"
			}
		},
		"./design-tokens": {
			"import": {
				"types": "./dist/types/designTokens.d.ts",
				"default": "./dist/design-tokens.mjs"
			},
			"require": {
				"types": "./dist/types-cjs/designTokens.d.cts",
				"default": "./dist/design-tokens.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"core": [
				"dist/types/core.d.ts"
			],
			"formatters": [
				"dist/types/formatters/index.d.ts"
			],
			"effects": [
				"dist/types/effects/index.d.ts"
			],
			"animation": [
				"dist/types/animation/index.d.ts"
			],
			"material": [
				"dist/types/material.d.ts"
			],
			"design-tokens": [
				"dist/types/designTokens.d.ts"
			],
			"*": [
				"dist/types/index.d.ts"
			]
		}
	},
	"scripts": {
		"build": "node ../../scripts/clean-build-output.mjs dist && vite build --config vite.config.ts && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/prepare-dual-declarations.mjs dist --node-extensions",
		"pack:dry": "npm pack --dry-run",
		"prepack": "npm run build",
		"type-check": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@material/material-color-utilities": "^0.4.0"
	},
	"devDependencies": {
		"typescript": "^5.5.4",
		"vite": "^5.4.1"
	}
}
